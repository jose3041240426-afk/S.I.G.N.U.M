# Signum ML Service - Variables de entorno
# Copiar a .env y rellenar con valores reales

# Supabase
SUPABASE_URL=https://nvkpfreeyemrpxxmqfqm.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# Se usa SERVICE_ROLE_KEY (no la anon key) para que el servicio pueda
# leer todas las muestras (bypass RLS) y escribir modelos en Storage.

# Puerto del servidor
PORT=8000

# Hiperparámetros por defecto del Random Forest
RF_N_TREES=50
RF_MAX_DEPTH=15
RF_MIN_SAMPLES_LEAF=2
